# 正方体模型：长宽高均 1 单位，居中于原点（-0.5 ~ 0.5）
# 六面法线朝外（OpenGL CCW 正面），每面 UV 平铺 0~1：
# 每个 1×1 世界单位格显示完整一张贴图（砖缝纹理 1×1 次重复）
mtllib cube.mtl

# ---- 顶点（每面 4 个，共 24 个）----
# +Z 面
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
# -Z 面
v -0.5 -0.5 -0.5
v -0.5  0.5 -0.5
v  0.5  0.5 -0.5
v  0.5 -0.5 -0.5
# +X 面
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v  0.5  0.5  0.5
v  0.5 -0.5  0.5
# -X 面
v -0.5 -0.5  0.5
v -0.5  0.5  0.5
v -0.5  0.5 -0.5
v -0.5 -0.5 -0.5
# +Y 面（顶）
v -0.5  0.5 -0.5
v -0.5  0.5  0.5
v  0.5  0.5  0.5
v  0.5  0.5 -0.5
# -Y 面（底）
v -0.5 -0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5 -0.5  0.5

# ---- UV（每面独立，0~1 平铺：1 单位 = 1 张完整贴图）----
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0
vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0

# ---- 法线（六面朝外）----
vn 0.0 0.0  1.0
vn 0.0 0.0 -1.0
vn 1.0 0.0  0.0
vn -1.0 0.0 0.0
vn 0.0 1.0  0.0
vn 0.0 -1.0 0.0

# ---- 面（四边形，assimp 自动三角化）----
usemtl cube_material
f 1/1/1 2/2/1 3/3/1 4/4/1
f 5/5/2 6/6/2 7/7/2 8/8/2
f 9/9/3 10/10/3 11/11/3 12/12/3
f 13/13/4 14/14/4 15/15/4 16/16/4
f 17/17/5 18/18/5 19/19/5 20/20/5
f 21/21/6 22/22/6 23/23/6 24/24/6